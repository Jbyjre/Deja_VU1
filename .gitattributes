# GitHub's language bar counts every file. These paths are sample data, film
# tooling and marketing copies, not the application, so they stay out of it.
*.gcode linguist-generated=true
frontend/demo/** linguist-generated=true
promo-video/** linguist-vendored=true
marketing-library/** linguist-documentation=true

# Leave the large film folders out of GitHub's "Download ZIP" and source archives.
# The files stay in the repository and its history.
marketing-library export-ignore
promo-video export-ignore
